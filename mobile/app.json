{
  "expo": {
    "name": "LetsGoRide",
    "slug": "letsgoride-mobile",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "letsgoride",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "NSCameraUsageDescription": "LetsGoRide may use the camera to capture profile photos and driver verification documents.",
        "NSPhotoLibraryUsageDescription": "LetsGoRide lets you choose profile photos from your photo library.",
        "NSLocationWhenInUseUsageDescription": "LetsGoRide uses your location during an active ride or delivery to provide live journey progress.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "co.zw.letsgoride"
    },
    "android": {
      "allowBackup": true,
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F0",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "package": "com.letsgo.ride"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "color": "#118B44"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow LetsGoRide to use Face ID for faster secure login."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LetsGoRide lets you choose profile photos from your photo library.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LetsGoRide uses your location during an active ride or delivery to provide live journey progress.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-font"
    ],
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F0"
    },
    "runtimeVersion": "exposdk:54.0.0",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6a3f6705-1e96-4f17-b884-b928baebf0ba"
      }
    }
  }
}
