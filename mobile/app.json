{
  "expo": {
    "name": "LetsGoRide",
    "slug": "letsgoride-mobile",
    "version": "2.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "letsgoride",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        },
        "NSCameraUsageDescription": "LetsGoRide may use the camera to capture profile photos and driver verification documents.",
        "NSPhotoLibraryUsageDescription": "LetsGoRide lets you choose profile photos from your photo library.",
        "NSLocationWhenInUseUsageDescription": "LetsGoRide uses your location for accurate pickups, nearby services and live journey progress while the app is in use.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "For Drivers and Couriers, LetsGoRide can continue sharing location during an active Ride Now trip or delivery when the app is in the background so the customer can follow live progress. Tracking stops when the active job ends.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "co.zw.letsgoride"
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F0",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "package": "com.letsgo.ride"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F14",
          "image": "./assets/branding/native-splash-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-dontwarn com.stripe.android.pushProvisioning.PushProvisioningActivity$g\n-dontwarn com.stripe.android.pushProvisioning.PushProvisioningActivityStarter$Args\n-dontwarn com.stripe.android.pushProvisioning.PushProvisioningActivityStarter$Error\n-dontwarn com.stripe.android.pushProvisioning.PushProvisioningActivityStarter\n-dontwarn com.stripe.android.pushProvisioning.PushProvisioningEphemeralKeyProvider"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "general_v1",
          "color": "#118B44",
          "sounds": [
            "./assets/sounds/letsgoride_notification.wav",
            "./assets/sounds/letsgoride_ride_request.wav",
            "./assets/sounds/letsgoride_courier_request.wav"
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow LetsGoRide to use Face ID for faster secure login."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LetsGoRide lets you choose profile photos from your photo library.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LetsGoRide uses your location for accurate pickups, nearby services and live journey progress while the app is in use.",
          "locationAlwaysAndWhenInUsePermission": "For Drivers and Couriers, LetsGoRide can continue sharing location during an active Ride Now trip or delivery when the app is in the background so the customer can follow live progress. Tracking stops when the active job ends.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-font"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6a3f6705-1e96-4f17-b884-b928baebf0ba"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/6a3f6705-1e96-4f17-b884-b928baebf0ba",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
