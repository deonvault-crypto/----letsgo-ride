{
  "expo": {
    "name": "LetsGoRide",
    "slug": "letsgoride-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "letsgoride",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "LetsGoRide may use the camera to capture profile photos and driver verification documents.",
        "NSPhotoLibraryUsageDescription": "LetsGoRide lets you choose profile photos from your photo library.",
        "NSLocationWhenInUseUsageDescription": "LetsGoRide uses your location during an active ride or delivery to provide live journey progress.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "co.zw.letsgoride"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F0",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.letsgo.ride"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow LetsGoRide to use Face ID for faster secure login."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LetsGoRide lets you choose profile photos from your photo library."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LetsGoRide uses your location during an active ride or delivery to provide live journey progress."
        }
      ],
      "expo-font"
    ],
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F0"
    },
    "runtimeVersion": "exposdk:54.0.0",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6a3f6705-1e96-4f17-b884-b928baebf0ba"
      }
    }
  }
}
