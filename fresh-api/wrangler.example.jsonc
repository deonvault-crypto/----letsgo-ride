{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "letsgoride-fresh-staging",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-13",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "FRESH_START_STAGING": "true" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "letsgoride-fresh-staging",
    "database_id": "REPLACE_WITH_NEW_EMPTY_DATABASE_UUID",
    "migrations_dir": "migrations"
  }]
}
